# Required: Anthropic API key used by the Claude Agent SDK.
ANTHROPIC_API_KEY=

# Optional: model override (default baked into Dockerfile).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional tuning (defaults shown).
# AGENT_PORT=4100
# WORKSPACE_DIR=/workspace
# MAX_BODY_BYTES=10485760
# SESSION_IDLE_MS=1800000
# MAX_TURNS=100
# SNAPSHOT_MAX_FILES=200
# SNAPSHOT_MAX_FILE_BYTES=1048576
# SYSTEM_PROMPT_APPEND=
