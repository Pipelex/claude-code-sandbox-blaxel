{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "strict": true,
    "noImplicitAny": false,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["server.mjs", "src/**/*.mjs"],
  "exclude": ["node_modules"]
}
